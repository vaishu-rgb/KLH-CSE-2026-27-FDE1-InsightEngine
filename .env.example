# ---------- PostgreSQL (Raw layer) ----------
POSTGRES_RAW_USER=raw_user
POSTGRES_RAW_PASSWORD=changeme
POSTGRES_RAW_DB=insightengine_raw
POSTGRES_RAW_PORT=5432

# ---------- PostgreSQL (Warehouse layer) ----------
POSTGRES_DW_USER=dw_user
POSTGRES_DW_PASSWORD=changeme
POSTGRES_DW_DB=insightengine_dw
POSTGRES_DW_PORT=5433

# ---------- PostgreSQL (Airflow metadata) ----------
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=changeme
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_PORT=5434

# ---------- Kafka ----------
KAFKA_BROKER=kafka:9092
KAFKA_EXTERNAL_BROKER=localhost:29092
KAFKA_TOPIC_ORDERS=orders_stream
KAFKA_CONSUMER_GROUP=insightengine_orders_consumer

# ---------- Host-side connection overrides ----------
RAW_DB_HOST=127.0.0.1
DW_DB_HOST=127.0.0.1
KAFKA_HOST_BROKER=localhost:29092

# ---------- Airflow ----------
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=<generate-with-python-cryptography>
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-production